{
  "name": "playlist-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ui:check": "node scripts/ui-static-audit.mjs",
    "a11y:check": "node scripts/a11y-static-audit.mjs",
    "contrast:check": "node scripts/theme-contrast-audit.mjs",
    "test": "npm run test:unit && npm run test:smoke && npm run test:e2e",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "node --env-file=.env scripts/e2e-test.mjs",
    "test:browser": "playwright test",
    "test:drafts:serve": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/serve-draft-acceptance.mjs",
    "test:drafts:finish": "node scripts/control-draft-acceptance.mjs finish",
    "test:drafts:abort": "node scripts/control-draft-acceptance.mjs abort",
    "test:browser:performance": "playwright test tests/browser/performance-budget.spec.ts --project=desktop",
    "test:browser:games": "playwright test tests/browser/games-multiplayer.spec.ts tests/browser/games-group-duel.spec.ts --project=desktop",
    "test:browser:install": "playwright install chromium",
    "test:browser:update": "playwright test --update-snapshots",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-source-package.ps1",
    "check:env": "node --env-file=.env scripts/check-env.mjs",
    "check:env:production": "node --env-file=.env scripts/check-env.mjs --production",
    "pilot:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/check-pilot.mjs",
    "runtime:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/check-runtime.mjs",
    "db:backup": "node --env-file=.env scripts/backup-database.mjs",
    "db:verify-backup": "node --env-file=.env scripts/verify-backup.mjs",
    "db:rehearse-restore": "node --env-file=.env scripts/rehearse-database-restore.mjs",
    "db:probe-load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/probe-sqlite-load.mjs",
    "pilot:rehearse-http": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/rehearse-http-worker.mjs",
    "pilot:rehearse-recovery": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/rehearse-http-recovery.mjs",
    "pilot:build-isolated": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-isolated.mjs",
    "db:backup-encrypted": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/encrypted-database-backup.mjs",
    "db:verify-encrypted": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/verify-encrypted-backup.mjs",
    "db:check": "node --env-file=.env scripts/check-data-integrity.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "maintenance:cleanup": "node --env-file=.env --experimental-strip-types scripts/cleanup-expired-data.mjs",
    "maintenance:games": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/game-maintenance-loop.mjs",
    "worker:events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/event-notification-worker.mjs",
    "worker:events:health": "npm run worker:events -- --health",
    "worker:events:supervise": "node scripts/event-worker-supervisor.mjs",
    "check:communities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/check-community-integrity.mjs",
    "content:seed": "node --env-file=.env scripts/seed-editorial-content.mjs",
    "demo:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/seed-community-demo.mjs --apply",
    "game:upgrade-open": "node --env-file=.env scripts/upgrade-open-duels.mjs",
    "game:refresh-videos": "node --env-file=.env --experimental-strip-types scripts/refresh-open-game-videos.mjs",
    "user:role": "node --env-file=.env scripts/set-user-role.mjs",
    "deploy:check": "npm run check:env:production && npm run db:check && npm run typecheck && npm run lint && npm run ui:check && npm run a11y:check && npm run contrast:check && npm run test:unit && npm run build && npm run test:browser",
    "start:production": "npm run db:migrate:deploy && next start",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mrlhumphreys/jbackgammon": "1.2.5",
    "@prisma/client": "^5.20.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
