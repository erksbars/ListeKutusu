# Spotify Developer Dashboard values
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Required for production owner login. Generate a long random value.
ADMIN_LOGIN_KEY=change_this_owner_login_key

# Used to sign the owner session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change_this_long_random_secret

# Current single-server SQLite database. PostgreSQL requires a planned schema migration.
DATABASE_URL="file:./dev.db"

# Maximum number of Spotify playlists managed by the owner account.
MANAGED_PLAYLIST_LIMIT=10000

# Used by smoke tests. Change to the deployed origin when testing production.
APP_URL=http://127.0.0.1:3000
