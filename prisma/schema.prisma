generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tek satırlık ayar tablosu: owner'ın Spotify bağlantısı + hedef playlist
model Settings {
  id                  Int       @id @default(1)
  spotifyUserId       String?
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  spotifyExpiresAt    DateTime?
  playlistId          String?
  playlistName        String?
}

// Site icinde kullaniciya ait kalici liste kaydi.
// Spotify playlisti sadece disari aktarma/kopyalama icin kullanilir.
model UserList {
  id                   String           @id @default(cuid())
  ownerName            String
  playlistName         String?
  bio                  String?
  profileStatus        String?
  universityName       String?
  universityPublic     Boolean          @default(false)
  pinnedFeedPostId     String?
  profileShowcase      String?
  favoriteGenres       String?
  profileTheme         String           @default("aurora")
  profileDensity       String           @default("comfortable")
  profileBanner        String           @default("line")
  featuredAchievementId String?
  role                 String           @default("member") // member | moderator | admin
  notifyFollows        Boolean          @default(true)
  notifyLikes          Boolean          @default(true)
  notifyAdds           Boolean          @default(true)
  email                String?          @unique
  passwordHash         String?
  slug                 String           @unique
  submitCode           String?          @unique
  spotifyPlaylistId    String?
  spotifyExternalUrl   String?
  spotifySnapshotId    String?
  status               String           @default("active") // active | deleted | recycled
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lastExportedAt       DateTime?
  recycledAt           DateTime?
  suggestions          Suggestion[]     @relation("ListSuggestions")
  submittedSuggestions Suggestion[]     @relation("SubmittedSuggestions")
  sessions             AccountSession[]
  feedPosts            FeedPost[]       @relation("FeedPostAuthor")
  feedLikes            FeedLike[]       @relation("FeedLikeUser")
  feedAdds             FeedListAdd[]    @relation("FeedAddUser")
  feedSaves            FeedSave[]       @relation("FeedSaveUser")
  feedHides            FeedHide[]       @relation("FeedHideUser")
  following            Follow[]         @relation("FollowFollower")
  followers            Follow[]         @relation("FollowFollowing")
  notifications        Notification[]   @relation("NotificationRecipient")
  notificationActions  Notification[]   @relation("NotificationActor")
  reportsMade          PostReport[]     @relation("ReportReporter")
  commentReportsMade   CommentReport[]  @relation("CommentReportReporter")
  blocksInitiated      UserBlock[]      @relation("Blocker")
  blocksReceived       UserBlock[]      @relation("Blocked")
  forumThreads         ForumThread[]
  forumReplies         ForumReply[]
  feedComments         FeedComment[]
  gameSessionsOwned    GameSession[] @relation("GameSessionOwner")
  gamePlayers          GamePlayer[]
  mediaLibrary         MediaLibraryEntry[]
  communitiesOwned     Community[]
  communityMemberships CommunityMember[]
  communityPosts       CommunityPost[]
  communityPostLikes   CommunityPostLike[]
  communityPostSaves   CommunityPostSave[]
  communityComments    CommunityComment[]
  communityReports     CommunityReport[]
  communityEvents      CommunityEvent[]
  eventResponses       CommunityEventRsvp[]
  eventNotificationJobs CommunityEventNotificationJob[]
  eventNotificationQueue CommunityEventNotificationRecipient[]
  communityAuditActions CommunityModerationLog[]
  communityReportsReviewed CommunityReport[] @relation("CommunityReportReviewer")
  ownershipOffersSent CommunityOwnershipOffer[] @relation("OwnershipOfferFrom")
  ownershipOffersReceived CommunityOwnershipOffer[] @relation("OwnershipOfferTo")
  platformCommunityCases PlatformCommunityCase[] @relation("PlatformCaseApplicant")
  platformCaseReviews PlatformCommunityCase[] @relation("PlatformCaseReviewer")
  platformCaseActions PlatformCommunityCaseEvent[]

  @@index([status, updatedAt])
  @@index([spotifyPlaylistId, status, lastExportedAt])
}

model Community {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  category    String
  rules       String
  universityName String?
  universityKey String?
  city        String?
  cityKey     String?
  interest    String?
  ownerId     String
  status      String @default("active")
  archivedAt  DateTime?
  lifecycleRevision Int @default(0)
  createdAt   DateTime @default(now())
  owner       UserList @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]
  reports     CommunityReport[]
  events      CommunityEvent[]
  moderationLogs CommunityModerationLog[]
  ownershipOffer CommunityOwnershipOffer?
  platformCases PlatformCommunityCase[]
  @@index([createdAt, id])
  @@index([interest, createdAt, id])
}

model CommunityOwnershipOffer {
  communityId String @id
  id          String @unique @default(cuid())
  fromUserId  String
  toUserId    String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fromUser    UserList @relation("OwnershipOfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      UserList @relation("OwnershipOfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  @@index([toUserId, expiresAt])
}

model CommunityEvent {
  id          String @id @default(cuid())
  communityId String
  organizerId String
  title       String
  description String
  startsAt    DateTime
  timeZone    String @default("Europe/Istanbul")
  city        String
  cityKey     String @default("")
  venue       String
  capacity    Int?
  status      String @default("scheduled")
  distribution String @default("community")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revision    Int @default(0)
  contentVersion Int @default(0)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizer   UserList @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  responses   CommunityEventRsvp[]
  notifications Notification[]
  notificationJobs CommunityEventNotificationJob[]
  @@index([communityId, status, startsAt, id])
  @@index([distribution, status, createdAt, id])
  @@index([distribution, status, startsAt, id])
}

model CommunityEventRsvp {
  eventId   String
  userId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      UserList @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, status])
}

model CommunityEventNotificationJob {
  id          String @id
  eventId     String
  actorId     String
  version     Int
  type        String
  createdAt   DateTime @default(now())
  availableAt DateTime @default(now())
  completedAt DateTime?
  failedAt    DateTime?
  failures    Int @default(0)
  revision    Int @default(0)
  errorCode   String?
  event       CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor       UserList @relation(fields: [actorId], references: [id], onDelete: Cascade)
  recipients  CommunityEventNotificationRecipient[]
  @@index([completedAt, failedAt, availableAt, createdAt, id])
}

model CommunityEventNotificationRecipient {
  jobId  String
  userId String
  job    CommunityEventNotificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user   UserList @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([jobId, userId])
  @@index([userId])
}

model CommunityMember {
  communityId String
  userId      String
  role        String @default("member")
  status      String @default("active")
  joinedAt    DateTime @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        UserList @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([communityId, userId])
  @@index([userId, status])
}

model CommunityPost {
  id          String @id @default(cuid())
  communityId String
  authorId    String
  title       String
  body        String
  type        String @default("discussion")
  reviewKind  String?
  subjectTitle String?
  rating      Int?
  spoiler     Boolean @default(false)
  sourceUrl   String?
  referenceProvider String?
  status      String @default("published")
  distribution String @default("community")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revision    Int @default(0)
  editedAt    DateTime?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      UserList @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    CommunityComment[]
  likes       CommunityPostLike[]
  saves       CommunityPostSave[]
  @@index([communityId, status, createdAt, id])
  @@index([distribution, status, createdAt, id])
}

model CommunityPostLike {
  userId String
  postId String
  createdAt DateTime @default(now())
  user UserList @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId])
}

model CommunityPostSave {
  userId String
  postId String
  createdAt DateTime @default(now())
  user UserList @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt, postId])
}

model CommunityComment {
  id        String @id @default(cuid())
  postId    String
  authorId  String
  body      String
  status    String @default("published")
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    UserList @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, status, createdAt, id])
}

model CommunityReport {
  id          String @id @default(cuid())
  communityId String
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  status      String @default("pending")
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedById String?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporter    UserList @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy  UserList? @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  platformAppeals PlatformCommunityCase[] @relation("PlatformCaseSourceReport")
  @@unique([reporterId, targetType, targetId])
  @@index([communityId, status, createdAt])
}

model CommunityModerationLog {
  id          String @id @default(cuid())
  communityId String
  actorId     String?
  action      String
  targetType  String
  targetId    String
  note        String?
  createdAt   DateTime @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor       UserList? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  platformAppeals PlatformCommunityCase[] @relation("PlatformCaseSourceDecision")
  @@index([communityId, createdAt, id])
}

model PlatformCommunityCase {
  id          String @id @default(cuid())
  communityId String
  applicantId String
  kind        String
  subjectKey  String
  sourceReportId String?
  sourceDecisionId String?
  reason      String
  status      String @default("pending")
  response    String?
  version     Int @default(0)
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewerId  String?
  reviewerKind String?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  applicant   UserList @relation("PlatformCaseApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer    UserList? @relation("PlatformCaseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  sourceReport CommunityReport? @relation("PlatformCaseSourceReport", fields: [sourceReportId], references: [id], onDelete: SetNull)
  sourceDecision CommunityModerationLog? @relation("PlatformCaseSourceDecision", fields: [sourceDecisionId], references: [id], onDelete: SetNull)
  events      PlatformCommunityCaseEvent[]
  @@unique([applicantId, subjectKey])
  @@index([applicantId, createdAt, id])
  @@index([status, createdAt, id])
}

model PlatformCommunityCaseEvent {
  id          String @id @default(cuid())
  caseId      String
  actorId     String?
  actorKind   String
  action      String
  createdAt   DateTime @default(now())
  application PlatformCommunityCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       UserList? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([caseId, createdAt, id])
}

// Private non-music library; showcasedAt is the explicit public-showcase opt-in.
model MediaLibraryEntry {
  id          String   @id @default(cuid())
  userId      String
  catalogId   String
  kind        String
  provider    String
  externalId  String
  title       String
  creators    String   @default("[]")
  year        Int?
  sourceUrl   String
  status      String
  showcasedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        UserList @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogId])
  @@index([userId, kind, createdAt, id])
  @@index([userId, showcasedAt])
}

model GameSession {
  id            String       @id @default(cuid())
  gameCode      String
  gameVersion   Int          @default(1)
  ownerId       String
  status        String       @default("setup") // setup | active | completed | abandoned
  visibility    String       @default("private") // private | unlisted | public
  source        String       @default("personal")
  targetSize    Int
  maxPlayers    Int          @default(2)
  currentRound  Int          @default(1)
  revision      Int          @default(0)
  state         String
  winnerEntryId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?
  owner         UserList     @relation("GameSessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  players       GamePlayer[]
  entries       GameEntry[]
  votes         GameVote[]
  events        GameEvent[]

  @@index([ownerId, status, updatedAt])
  @@index([gameCode, status, createdAt])
}

model GamePlayer {
  id            String      @id @default(cuid())
  sessionId     String
  userId        String
  seat          Int         @default(0)
  status        String      @default("ready")
  score         Int         @default(0)
  state         String      @default("{}")
  winnerEntryId String?
  joinedAt      DateTime    @default(now())
  completedAt   DateTime?
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          UserList    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         GameVote[]
  entries       GameEntry[] @relation("GamePlayerEntries")
  events        GameEvent[]

  @@unique([sessionId, userId])
  @@unique([sessionId, seat])
  @@index([userId, joinedAt])
}

model GameEvent {
  id        String      @id @default(cuid())
  sessionId String
  playerId  String?
  eventType String
  summary   String
  metadata  String      @default("{}")
  revision  Int
  createdAt DateTime    @default(now())
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player    GamePlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([sessionId, revision])
}

model GameEntry {
  id                  String      @id @default(cuid())
  sessionId           String
  submittedByPlayerId String?
  trackId             String
  trackName           String
  artistName          String
  externalUrl         String?
  youtubeVideoId      String?
  seed                Int
  createdAt           DateTime    @default(now())
  session             GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submittedByPlayer   GamePlayer? @relation("GamePlayerEntries", fields: [submittedByPlayerId], references: [id], onDelete: SetNull)
  votes               GameVote[]

  @@unique([sessionId, trackId])
  @@index([sessionId, seed])
  @@index([sessionId, submittedByPlayerId])
}

model GameVote {
  id            String      @id @default(cuid())
  sessionId     String
  playerId      String
  selectedEntryId String
  roundNumber   Int
  matchupNumber Int
  createdAt     DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player        GamePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  selectedEntry GameEntry   @relation(fields: [selectedEntryId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId, roundNumber, matchupNumber])
  @@index([sessionId, roundNumber, matchupNumber])
}

model AccountSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  persistent Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       UserList  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

// Onay bekleyen / onaylanmış / reddedilmiş şarkı önerileri
model Suggestion {
  id            String        @id @default(cuid())
  listId        String?
  trackId       String
  trackUri      String
  trackName     String
  artistName    String
  durationMs    Int
  suggestedBy   String?
  suggestedById String?
  status        String        @default("pending") // pending | approved | rejected | removed
  createdAt     DateTime      @default(now())
  decidedAt     DateTime?
  list          UserList?     @relation("ListSuggestions", fields: [listId], references: [id])
  submitter     UserList?     @relation("SubmittedSuggestions", fields: [suggestedById], references: [id], onDelete: SetNull)
  feedAdds      FeedListAdd[]

  @@index([listId, status, createdAt])
  @@index([listId, trackId])
  @@index([suggestedById, createdAt])
}

// Herkese acik sosyal muzik akisi.
// Spotify sadece kaynak/link olarak tutulur; asil etkilesim verisi uygulamanindir.
model FeedPost {
  id            String         @id @default(cuid())
  authorId      String
  trackId       String
  trackUri      String?
  trackName     String
  artistName    String
  albumName     String?
  durationMs    Int?
  externalUrl   String?
  source        String         @default("spotify")
  note          String?
  tags          String?
  status        String         @default("published")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  author        UserList       @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes         FeedLike[]
  adds          FeedListAdd[]
  saves         FeedSave[]
  hides         FeedHide[]
  notifications Notification[]
  reports       PostReport[]
  comments      FeedComment[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model FeedComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  status    String        @default("published") // published | removed
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    UserList      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   FeedComment[] @relation("FeedCommentReplies")
  reports   CommentReport[]

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, status, createdAt])
}

model CommentReport {
  id         String      @id @default(cuid())
  reporterId String
  commentId  String
  reason     String
  details    String?
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
  reviewedAt DateTime?
  reporter   UserList    @relation("CommentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  comment    FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
}

model FeedLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserList @relation("FeedLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model FeedListAdd {
  id           String      @id @default(cuid())
  postId       String
  userId       String
  suggestionId String?
  createdAt    DateTime    @default(now())
  post         FeedPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         UserList    @relation("FeedAddUser", fields: [userId], references: [id], onDelete: Cascade)
  suggestion   Suggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([suggestionId])
}

model FeedSave {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserList @relation("FeedSaveUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model FeedHide {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserList @relation("FeedHideUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    UserList @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   UserList @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model Notification {
  id            String       @id @default(cuid())
  userId        String
  actorId       String?
  postId        String?
  forumThreadId String?
  communityEventId String?
  type          String
  readAt        DateTime?
  createdAt     DateTime     @default(now())
  user          UserList     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor         UserList?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post          FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  forumThread   ForumThread? @relation(fields: [forumThreadId], references: [id], onDelete: Cascade)
  communityEvent CommunityEvent? @relation(fields: [communityEventId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([actorId, createdAt])
  @@index([postId])
  @@index([forumThreadId])
}

model ForumThread {
  id              String         @id @default(cuid())
  slug            String         @unique
  authorId        String
  category        String
  title           String
  body            String
  status          String         @default("pending") // pending | published | rejected | removed
  views           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedAt      DateTime?
  lastActivityAt  DateTime       @default(now())
  lockedAt        DateTime?
  acceptedReplyId String?        @unique
  acceptedAt      DateTime?
  author          UserList       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies         ForumReply[]   @relation("ForumThreadReplies")
  acceptedReply   ForumReply?    @relation("ForumAcceptedReply", fields: [acceptedReplyId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@index([status, lastActivityAt])
  @@index([category, status, lastActivityAt])
  @@index([authorId, createdAt])
}

model ForumReply {
  id          String       @id @default(cuid())
  threadId    String
  authorId    String
  body        String
  status      String       @default("published") // published | removed
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  thread      ForumThread  @relation("ForumThreadReplies", fields: [threadId], references: [id], onDelete: Cascade)
  acceptedFor ForumThread? @relation("ForumAcceptedReply")
  author      UserList     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, status, createdAt])
  @@index([authorId, createdAt])
}

model PostReport {
  id         String    @id @default(cuid())
  reporterId String
  postId     String
  reason     String
  details    String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reporter   UserList  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post       FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@index([status, createdAt])
  @@index([postId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   UserList @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   UserList @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

// Yönetim panelinde gerçekleştirilen kritik işlemlerin değiştirilemez geçmişi.
model AdminAuditLog {
  id          String   @id @default(cuid())
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, createdAt])
}
