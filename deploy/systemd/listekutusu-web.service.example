# Optional Linux template, NOT installed. See docs/TEKNIK_KAPANIS_VE_YAYIN.md.
[Unit]
Description=ListeKutusu production web
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=listekutusu
Group=listekutusu
WorkingDirectory=/srv/listekutusu/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/listekutusu/app.env
ExecStartPre=/usr/bin/node scripts/check-env.mjs --production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/listekutusu/data /srv/listekutusu/app/tmp /srv/listekutusu/app/.next/cache

[Install]
WantedBy=multi-user.target
